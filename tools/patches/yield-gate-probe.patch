+// ── Yield-gate probe (env GBARECOMP_YIELD_PROBE=1) ────────────────────────
+// Diagnostic for fast-clock hunts: classifies vblank windows whose yield
+// never fired (their guest frames collapse into a neighboring pacer visit,
+// letting the guest wall-clock run fast). Two lenses, both cheap:
+//  * per-check blocks: while a yield is pending, which gate term fails
+//    (IRQ nesting vs CPU mode, with a mode histogram);
+//  * per-window misses: at each vblank increment, whether the previous
+//    window saw any yield; a miss is attributed to the state snapshotted
+//    at that window's start (mode / in-handler / CPU-halted).
+// Off by default: the hot path pays one predictable branch.
+namespace {
+struct YieldProbe {
+    bool on = false;
+    bool have_prev = false;
+    bool yielded_in_window = false;
+    uint32_t prev_mode = 0;
+    bool prev_nest = false;
+    bool prev_halted = false;
+    unsigned long long windows = 0;
+    unsigned long long yields = 0;
+    unsigned long long multi_yields = 0;  // yield spanning 2+ vblanks
+    unsigned long long miss_mode = 0;
+    unsigned long long miss_nest = 0;
+    unsigned long long miss_halted = 0;
+    unsigned long long miss_open = 0;
+    unsigned long long miss_mode_hist[32] = {};
+    unsigned long long blk_nest = 0;
+    unsigned long long blk_mode = 0;
+    unsigned long long blk_mode_hist[32] = {};
+    unsigned long long last_yield_vb = 0;
+    bool have_yield = false;
+};
+YieldProbe g_yield_probe;
+void yield_probe_print() {
+    YieldProbe& p = g_yield_probe;
+    if (!p.on) return;
+    std::fprintf(stderr,
+        "[yield-probe] win=%llu yields=%llu multi=%llu "
+        "miss(mode=%llu nest=%llu halted=%llu open=%llu) "
+        "blocked(nest=%llu mode=%llu)\n",
+        p.windows, p.yields, p.multi_yields,
+        p.miss_mode, p.miss_nest, p.miss_halted, p.miss_open,
+        p.blk_nest, p.blk_mode);
+    for (int m = 0; m < 32; ++m) {
+        if (p.blk_mode_hist[m] || p.miss_mode_hist[m])
+            std::fprintf(stderr,
+                "[yield-probe] mode=0x%02x blocked=%llu missed=%llu\n",
+                m, p.blk_mode_hist[m], p.miss_mode_hist[m]);
+    }
+    std::fflush(stderr);
+}
+void yield_probe_ensure_init() {
+    static bool done = false;
+    if (done) return;
+    done = true;
+    const char* e = std::getenv("GBARECOMP_YIELD_PROBE");
+    g_yield_probe.on = (e && *e && *e != '0');
+    if (g_yield_probe.on) std::atexit(yield_probe_print);
+}
+// Called at each vblank increment, with the guest state as of this tick.
+inline void yield_probe_on_vblank(uint32_t mode, bool nest, bool halted,
+                                  unsigned long long vb) {
+    yield_probe_ensure_init();
+    YieldProbe& p = g_yield_probe;
+    if (!p.on) return;
+    if (p.have_prev && !p.yielded_in_window) {
+        // The previous window elapsed with no yield: attribute it to the
+        // state recorded when that window opened.
+        if (p.prev_nest) ++p.miss_nest;
+        else if (p.prev_mode != 0x10u && p.prev_mode != 0x1Fu) {
+            ++p.miss_mode;
+            ++p.miss_mode_hist[p.prev_mode & 31u];
+        } else if (p.prev_halted) ++p.miss_halted;
+        else ++p.miss_open;  // gate was open at window start: the guest must
+                             // have become unyieldable mid-window (e.g. halted
+                             // mid-window, so no further checks ran)
+    }
+    p.prev_mode = mode;
+    p.prev_nest = nest;
+    p.prev_halted = halted;
+    p.yielded_in_window = false;
+    p.have_prev = true;
+    ++p.windows;
+}
+// Called wherever the vblank yield fires (hook + unwind paths share the
+// yielded_vblank_start assignment below).
+inline void yield_probe_on_yield(unsigned long long vb) {
+    YieldProbe& p = g_yield_probe;
+    if (!p.on) return;
+    ++p.yields;
+    if (p.have_yield && vb >= p.last_yield_vb + 2) ++p.multi_yields;
+    p.last_yield_vb = vb;
+    p.have_yield = true;
+    p.yielded_in_window = true;
+    if ((p.yields % 600ull) == 0ull) yield_probe_print();
+}

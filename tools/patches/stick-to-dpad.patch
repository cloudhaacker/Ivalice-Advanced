diff --git a/src/runtime/input_synth.h b/src/runtime/input_synth.h
index d1df4da..aab700e 100644
--- a/src/runtime/input_synth.h
+++ b/src/runtime/input_synth.h
@@ -27,6 +27,21 @@ enum GbaKey : std::uint16_t {
     kGbaKeyAll = 0x03FFu,
 };
 
+// Active-high d-pad bits for an SDL game-controller stick position (issue
+// #14): SDL axes run -32768..32767 with up/left negative, and a direction
+// registers when its axis passes beyond `deadzone` in magnitude. Inside the
+// deadzone nothing registers, so stick drift cannot press a direction; a
+// diagonal naturally sets two bits. Pure so host input policies (and tests)
+// can share one mapping.
+inline std::uint16_t stick_to_dpad(int axis_x, int axis_y, int deadzone) {
+    std::uint16_t keys = 0;
+    if (axis_x < -deadzone) keys |= kGbaKeyLeft;
+    if (axis_x > deadzone) keys |= kGbaKeyRight;
+    if (axis_y < -deadzone) keys |= kGbaKeyUp;
+    if (axis_y > deadzone) keys |= kGbaKeyDown;
+    return keys;
+}
